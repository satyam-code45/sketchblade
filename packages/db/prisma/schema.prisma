generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// Second generator so the Next.js app has its own local Prisma client.
// This puts the binary inside the app directory — exactly where Next.js
// serverless functions look for it at runtime on Vercel.
generator clientNextjs {
  provider      = "prisma-client-js"
  output        = "../../../apps/excalidraw-frontend/src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  name     String
  photo    String?

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
  Room      Room[]
  Chat      Chat[]
  BoardEvent BoardEvent[]
  AICredential AICredential[]
  AIPreference AIPreference?
}

model Room {
  id       Int     @id @default(autoincrement())
  slug     String  @unique
  name     String?
  adminId  String
  admin    User    @relation(fields: [adminId], references: [id])
  password String?

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
  Chat      Chat[]
  BoardEvent BoardEvent[]
}

model Chat {
  id Int @id @default(autoincrement())

  message String
  // user | ai | system; AI replies have no author
  kind String @default("user")

  roomId Int
  room   Room @relation(fields: [roomId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  // paging filters by room, orders by id
  @@index([roomId, id])
}

// Append-only board mutations, replayed per room to rebuild the canvas.
model BoardEvent {
  id     Int    @id @default(autoincrement())
  roomId Int
  userId String

  // shape_upsert | shape_erase | snapshot
  kind    String
  // Raw JSON string, not Json — nothing queries inside it.
  payload String

  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([roomId, id])
}

// Encrypted, not hashed: we need the key back to call the provider.
model AICredential {
  id       String @id @default(uuid())
  userId   String
  provider String
  label    String

  ciphertext Bytes
  iv         Bytes
  authTag    Bytes
  keyVersion Int    @default(1)

  // sha256 of the raw key, so duplicates are caught without decrypting
  fingerprint String
  last4       String

  lastUsedAt  DateTime?
  lastValidAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, provider])
}

model AIPreference {
  userId       String  @id
  provider     String  @default("openai")
  // null means fall back to the platform key and its free-tier quota
  credentialId String?

  modelDiagram  String?
  modelEvaluate String?
  modelEdit     String?
  modelChat     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
