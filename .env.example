# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored. This file is safe to commit.

# ── Database ─────────────────────────────────────────────────────────────────
# Get a free PostgreSQL URL at https://neon.tech or use a local instance.
DATABASE_URL="postgresql://user:password@host:5432/sketchblade?sslmode=require"

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production


WS_PORT=8080

# ── Frontend URLs (optional — defaults to localhost) ─────────────────────────
# Update these for staging/production deployments.
NEXT_PUBLIC_HTTP_BACKEND=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# ── Cloudinary (image & video insert on the canvas) ──────────────────────────
# All three come from your Cloudinary console dashboard (cloudinary.com/console).
# These are kept server-side (no NEXT_PUBLIC_ prefix) — the API secret signs
# each upload from /api/cloudinary/sign, but the file itself is sent straight
# from the browser to Cloudinary, never through our server.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
