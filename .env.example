# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored. This file is safe to commit.

# ── Database ─────────────────────────────────────────────────────────────────
# Get a free PostgreSQL URL at https://neon.tech or use a local instance.
DATABASE_URL="postgresql://user:password@host:5432/sketchblade?sslmode=require"

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production


WS_PORT=8080

# ── Frontend URLs (optional — defaults to localhost) ─────────────────────────
# Update these for staging/production deployments.
NEXT_PUBLIC_HTTP_BACKEND=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# ── Cloudinary (image & video insert on the canvas) ──────────────────────────
# All three come from your Cloudinary console dashboard (cloudinary.com/console).
# These are kept server-side (no NEXT_PUBLIC_ prefix) — the API secret signs
# each upload from /api/cloudinary/sign, but the file itself is sent straight
# from the browser to Cloudinary, never through our server.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── AI ────────────────────────────────────────────────────────────────────────
# Platform default key. Users can supply their own instead (see settings).
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Per-task model. Reasoning-heavy tasks get the stronger tier.
AI_MODEL_DIAGRAM=gpt-5.6-luna
AI_MODEL_EVALUATE=gpt-5.6-terra
AI_MODEL_EDIT=gpt-5.6-terra
AI_MODEL_CHAT=gpt-5.6-luna

# ── Realtime scaling (optional) ─────────────────────────────────────────────
# Unset = single instance. Set it and the WS servers fan out through Redis,
# so more than one instance can serve the same room.
# Local: docker run -d -p 6379:6379 redis:7-alpine
REDIS_URL=
